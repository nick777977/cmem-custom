{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 20,
            "commandWindows": "exit 1"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 20,
            "commandWindows": "exit 1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$|^mcp__.+__(read|view|cat)(_file|_files)?$|^Grep$|^Glob$|^memory_search$|^memory$|^mcp__.+__memory_search$",
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 30,
            "commandWindows": "exit 1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 5,
            "commandWindows": "exit 1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 60,
            "commandWindows": "exit 1"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 20,
            "commandWindows": "exit 1"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exit 1",
            "timeout": 20,
            "commandWindows": "exit 1"
          }
        ]
      }
    ]
  }
}
